# Copy to .env on EC2; never commit real values.
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=latest

DOMAIN=dockett.maazhafeez.com
ACME_EMAIL=you@example.com
WEB_URL=https://dockett.maazhafeez.com
BASE_URL=https://dockett.maazhafeez.com

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=dev
DATABASE_URL=postgres://postgres:URL_ENCODED_PASSWORD@postgresdb:5432/dev

JWT_SECRET=replace-with-at-least-64-random-hex-characters
GOOGLE_CLIENT_ID=your-google-web-oauth-client-id
# Resend > API Keys > Create API Key (server-side; never expose to the browser).
RESEND_API_KEY=
EMAIL_FROM_NAME=Dockett
# Use an address on a domain verified in Resend > Domains.
EMAIL_FROM_ADDRESS=
# Optional: replies go to this address instead of the sender.
EMAIL_REPLY_TO=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=60
TRUST_PROXY=1
LOGGER_LEVEL=info

# Paddle Billing. Keep these server-side values in the deployment .env only.
# Use separate credentials and price IDs for sandbox and production.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_ID_PREMIUM_MONTHLY=
PADDLE_PRICE_ID_PREMIUM_YEARLY=
# Optional: Pro access grace period after a failed renewal; defaults to 7 days.
BILLING_GRACE_DAYS=7
# Optional: webhook timestamp tolerance; defaults to 300 seconds.
PADDLE_WEBHOOK_TOLERANCE_SEC=300

# Optional Cloudinary-backed uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SIGNATURE_ALGORITHM=sha1
CLOUDINARY_DELIVERY_TYPE=authenticated

# Optional application upload limits.
UPLOAD_MAX_FILE_MB=5
UPLOAD_SIGN_LIMIT_PER_10_MIN=30
UPLOAD_MAX_PENDING_PER_ACTOR=10
UPLOAD_FORM_MAX_UNATTACHED=50
UPLOAD_OWNER_STORAGE_MB=500
UPLOAD_CLEANUP_INTERVAL_MIN=15

# Public frontend variables are baked into the web bundle during the GitHub Actions build.
# Configure them as GitHub Actions repository variables, not on the running EC2 container.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-oauth-client-id
# NEXT_PUBLIC_SALES_EMAIL=
# NEXT_PUBLIC_SALES_WHATSAPP=
# NEXT_PUBLIC_SALES_PHONE=
