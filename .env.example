# Copy this file to .env on the EC2 host and replace the example values.
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=latest

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=dev
POSTGRES_PORT=5432

# Use the public URL users will visit. NEXT_PUBLIC_API_URL is baked into the web build.
WEB_URL=http://YOUR_EC2_PUBLIC_DNS:3000
BASE_URL=http://YOUR_EC2_PUBLIC_DNS:8000
NEXT_PUBLIC_API_URL=http://YOUR_EC2_PUBLIC_DNS:8000/trpc
WEB_PORT=3000
API_PORT=8000

# The API container reaches Postgres by its Compose service name, not localhost.
DATABASE_URL=postgresql://postgres:replace-with-a-strong-database-password@postgresdb:5432/dev

# Required by the app's server-side configuration.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
SMTP_USER=replace-with-your-smtp-user
SMTP_PASS=replace-with-your-smtp-app-password

# Optional public settings; set these before building if you use them.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_SALES_EMAIL=
NEXT_PUBLIC_SALES_WHATSAPP=
NEXT_PUBLIC_SALES_PHONE=
